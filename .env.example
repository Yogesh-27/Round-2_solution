# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cafe_points?schema=public"

# JWT signing secret - use a long random value in real deployments
JWT_SECRET="cafe-points-local-demo-secret-2026"

# Server
PORT=4000
NODE_ENV=development

# Frontend origin(s), comma-separated
CORS_ORIGIN="http://localhost:5173"

# Optional rate limit tuning
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
